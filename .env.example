# Local OpenAI-compatible server (LM Studio, the server the recordings were made with); no real keys needed.
# `localhost` is for running evalrag directly on your machine. For Docker use
# `http://host.docker.internal:1234/v1` instead (the compose file does this by default when
# these are unset; do not copy these localhost values into a Docker .env).
LLM_BASE_URL=http://localhost:1234/v1
EMBED_BASE_URL=http://localhost:1234/v1
LLM_MODEL=qwen2.5-7b-instruct-1m
EMBED_MODEL=text-embedding-nomic-embed-text-v1.5
# Optional tuning (defaults shown):
# TOP_K=3
# MIN_DENSE_SCORE=0.67
